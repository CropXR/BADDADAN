rule go_annotate:
    input:
        "split_by_module/{id}.csv",
        "../../../resources/go_annotations/tair.gaf.all_background_genes",
        "../../../resources/go_annotations/tair.gaf",
    params:
        obo="../../../resources/go_annotations/go-basic.obo"
    output:
        "go_outputs_exp_evidence_only/{id}.tsv"
    log:
        "go_outputs_exp_evidence_only/{id}.log"
    shell:
        "find_enrichment.py {input} --pval=0.05 --method=fdr_bh --pval_field=fdr_bh --obo {params.obo} --ns=BP "
        "--outfile {output} "
        "--ev_inc Experimental --ev_exc Similarity,Combinatorial,High_Throughput,Author,Curatorial,ND,IEA "
        "> {log}"