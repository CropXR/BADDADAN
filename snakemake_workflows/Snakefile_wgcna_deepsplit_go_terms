from glob import glob

# IDS, = glob_wildcards("random_split_by_module/{id}.csv")
IDS, = glob_wildcards("split_by_module/{id}.csv")
# IDS = [id for id in IDS if "ds1" in id]
# IDS = [id for id in IDS if "local_dists_wgcna_clustered_ds2" in id]

rule target:
    # Uncomment correct line to do
    input:
        expand("go_outputs_exp_evidence_only_background_de_genes/{id}.tsv", id=IDS)
        # expand("go_outputs_exp_evidence_only/{id}.tsv", id=IDS)


rule go_annotate_only_DE_background:
    input:
        "split_by_module/{id}.csv",
        "all_DE_genes.txt",
        # lambda wildcards: glob("all_DE_genes*.txt")[0],  # Takes the first matching file
        # '../../../resources/go_annotations/ATH_GO_GOSLIM_one_gene_per_line.txt',
        "../../../resources/go_annotations/tair.gaf",
    params:
        obo="../../../resources/go_annotations/go-basic.obo"
    output:
        "go_outputs_exp_evidence_only_background_de_genes/{id}.tsv"
    log:
        "go_outputs_exp_evidence_only_background_de_genes/{id}.log"
    shell:
        "find_enrichment.py {input} --pval=0.05 --method=fdr_bh --pval_field=fdr_bh --obo {params.obo} --ns=BP "
        "--outfile {output} "
        "--ev_inc Experimental --ev_exc Similarity,Combinatorial,High_Throughput,Author,Curatorial,ND,IEA "
        "> {log}"

rule get_de_genes:
    input:
        'dyntreecut_output/combined_sum_dists_w_0_5_wgcna_clustered_ds1.csv'
    output:
        "all_DE_genes.txt"
    shell:
        """
        cut -f2 -d, {input} | tail -n +2 | sed 's/"//g' > {output}
        """
